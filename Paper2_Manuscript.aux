\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}The porosity paradox: empirical evidence against the volumetric assumption}{7}{subsection.3.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Packing-media void fraction and end-point biomass retention outcomes.}}{8}{table.1}\protected@file@percent }
\newlabel{tab:packing_summary}{{1}{8}{Packing-media void fraction and end-point biomass retention outcomes}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Retention capacity ($R$) versus porosity ($\varepsilon $) across packing media. The relationship is non-monotonic: glass marbles exhibit the lowest retention despite moderate porosity, while pea gravels achieve high retention despite lower porosity. This pattern falsifies a strict volumetric interpretation of biomass retention.}}{8}{figure.1}\protected@file@percent }
\newlabel{fig:retention_vs_porosity}{{1}{8}{Retention capacity ($R$) versus porosity ($\varepsilon $) across packing media. The relationship is non-monotonic: glass marbles exhibit the lowest retention despite moderate porosity, while pea gravels achieve high retention despite lower porosity. This pattern falsifies a strict volumetric interpretation of biomass retention}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Stage~I results: hydraulic signatures reveal medium-specific flow resistance}{8}{subsection.3.2}\protected@file@percent }
