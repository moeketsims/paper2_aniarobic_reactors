\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Posterior distributions (means and 95\% HDIs) for regression coefficients across competing Stage~II retention models. Top left: volumetric model (porosity-only). Top right: hydraulic-signature model ($\log k$ and $\log (1+\beta _{\mathrm  {F}})$). Bottom left: combined model (porosity plus hydraulic signatures). Bottom right: GDI-only model. The combined model exhibits the tightest clustering of positive coefficients, while the GDI model shows a null effect centered at zero.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:forest_all_models}{{3}{12}{Posterior distributions (means and 95\% HDIs) for regression coefficients across competing Stage~II retention models. Top left: volumetric model (porosity-only). Top right: hydraulic-signature model ($\log k$ and $\log (1+\beta _{\mathrm {F}})$). Bottom left: combined model (porosity plus hydraulic signatures). Bottom right: GDI-only model. The combined model exhibits the tightest clustering of positive coefficients, while the GDI model shows a null effect centered at zero}{figure.3}{}}
